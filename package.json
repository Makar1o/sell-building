{
  "name": "capstone-mykytyn",
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "compile:sass": "sass src/scss:dist/css --no-source-map",
    "lint": "eslint . && stylelint \"**/*.{css,scss}\"",
    "lint:fix": "eslint . --fix && stylelint \"**/*.{css,scss}\" --fix",
    "prepare": "husky install"
  },
  "devDependencies": {
    "eslint": "^9.24.0",
    "eslint-config-prettier": "^10.1.1",
    "husky": "^9.0.11",
    "lint-staged": "^15.2.2",
    "prettier": "^3.5.3",
    "sass": "^1.86.3",
    "stylelint": "^16.17.0",
    "stylelint-config-recommended-vue": "^1.6.0",
    "stylelint-config-standard": "^37.0.0",
    "stylelint-config-standard-scss": "^14.0.0",
    "vite": "^6.3.2"
  },
  "dependencies": {
    "leaflet": "^1.9.4"
  },
  "lint-staged": {
    "**/*.{js,jsx,ts,tsx}": "eslint --fix",
    "**/*.{css,scss}": "stylelint --fix",
    "**/*.{js,jsx,ts,tsx,css,scss,html,json,md}": "prettier --write"
  }
}
